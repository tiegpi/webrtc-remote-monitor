# 复制成 .env 再填（.env 已 gitignore，不会进仓库）
#
#     cp .env.example .env && $EDITOR .env
#
# 前三个值必须和信令服务器的启动参数对得上，否则连接会被
# {"type":"error","code":"bad-room"} 直接关掉 —— 那是**静默**的：
# 页面看着什么都没发生，板子和浏览器两边日志都不指向真原因。

# 房间号。信令服务器启动时只认它自己那一个房间。
# 它不再是唯一的访问控制（外网入口还有 Basic Auth），但仍当成密钥对待。
ROOM=

# 发布端 token。板子连 --signal .../ws/publish 时用。
TOKEN=

# 信令服务器主机（VPS）。脚本自己拼 wss://（发布端）和 https://（观看页）。
SIGNAL_HOST=

# VPS 观看端的 HTTP Basic Auth，格式 user:pass（和部署脚本打印的一致）。
# 板子自己取 /ice.json、POST /diag、连 /ws/view 时用；局域网浏览器不需要输入。
# 换密码时 VPS 和板子两边都要改，否则板子侧的 ICE/遥测/局域网观看会 401。
SIGNAL_AUTH=

# 可选：部署 / 运维脚本的 ssh 目标。填了之后 tools/service_vps.sh、
# tools/set_view_password.sh、tools/gop_sweep.sh 就不用每次在命令行带。
# VPS_HOST=ubuntu@1.2.3.4
# BOARD_HOST=orangepi@192.168.2.100

# ------------------------------------------------------------------ 运行模式
# monitor（默认）= 采集后直接硬件编码推流：推流 + 双向语音 + 遥操作命令台。
# ros            = 图像走 ROS 2 话题总线，采集和推理分别是 camera_node、
#                  detector_node（见 ros2_ws/ 和 README 的「ROS 模式」），
#                  本进程只订阅 /detect/image_annotated 并推给浏览器。
#
# 两个模式**不兼容的只有视频前端**：信令、ICE、音频回程、会话管理都是同一份。
# 切模式要重启 agent（MODE=ros tools/service.sh restart agent），
# 而且要先把节点起起来（tools/run-ros-nodes.sh）。
# MODE=monitor

# ros 模式下启动用哪一路（mipi/usb）。不填就用 device_agent 的默认值，
# 运行期都靠页面按钮或 /camera/select 话题换。
# CAMERA_SOURCE=mipi

# ros 模式的话题名。四个默认值见 src/ros_mode.py 顶部常量，
# 只有对接别人的节点（usb_cam、自研 detector）时才需要改。
# ROS_IMAGE_TOPIC=/detect/image_annotated
# ROS_PERSONS_TOPIC=/detect/persons
# ROS_SELECT_TOPIC=/camera/select
# ROS_SOURCE_TOPIC=/camera/source

